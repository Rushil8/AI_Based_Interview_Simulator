# ==========================================
# AI Interview Coach - Environment Configuration
# ==========================================

# Application
APP_NAME="AI Interview Coach"
ENVIRONMENT=development
DEBUG=true

# Database Configuration
# Default: Local SQLite database for zero-config immediate execution
# Production: postgresql://postgres:postgres@localhost:5432/interview_coach
DATABASE_URL=sqlite:///./interview_coach.db

# Google Gemini Flash API Configuration
# Get your API key from Google AI Studio: https://aistudio.google.com/
# Leave empty or set MOCK_AI=true to run in local deterministic mode without API calls
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
MOCK_AI=true

# Security
SECRET_KEY=dev-secret-key-change-in-production-ai-interview-coach-2026
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Scoring Rubric Dimension Weights (Must total 1.0 / 100%)
RUBRIC_WEIGHT_RELEVANCE=0.20
RUBRIC_WEIGHT_TECHNICAL=0.40
RUBRIC_WEIGHT_COMPLETENESS=0.25
RUBRIC_WEIGHT_COMMUNICATION=0.15
RUBRIC_VERSION=v1.0

# Sentence-BERT Semantic Diagnostic Threshold
SEMANTIC_SIMILARITY_FLAG_THRESHOLD=0.50

# Interview Controller Constraints
MAX_UPLOAD_SIZE_MB=10
DEFAULT_QUESTIONS_COUNT=5
HIGH_SCORE_THRESHOLD=80.0
LOW_SCORE_THRESHOLD=55.0
